[General]
keep_archive = Yes
intermediate_products = No

[Janesick]
box_size = 100

[Image sections]
polynomial_degree = 14
trimsection = [49:2094,31:4128]
overscan = [2095:2142,1:4128]

[CCD reduction]
pixel_shifts = No

[ccdmask]
findbadcolumns = True
ncmed = 12
nlmed = 12
ncsig = 25
nlsig = 25
lsigma = 9
hsigma = 9

[Image Stacking]
excl_ccds = [6,8]

[SExtractor]
execute = Yes
sourceminflux = 200
sourcemaxflux = 20000
sourcefluxradius = 10

[Scamp]
nthreads = 0

[Paths]
data_products = /data/beegfs/astro-storage/groups/schinnerer/PHANGS/WFI/data_products
